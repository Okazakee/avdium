# Maintainer: Okazakee <okazakee@proton.me>
# Template for the AUR binary package. Placeholders follow native-packages
# 0.7.0 syntax. This recipe is staged and must not be pushed to the AUR without
# explicit authorization; see PACKAGING.md.
pkgname=avdium-bin
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="A native Android virtual device manager"
arch=('x86_64')
url="https://github.com/Okazakee/avdium"
license=('MIT')
# Nothing beyond libc is linked directly. winit and glutin dlopen these at
# startup, and Avdium is a GUI application, so they all have to be present for
# it to run at all.
depends=('libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb')
optdepends=('xdg-desktop-portal: native folder picker for SDK and AVD locations')
options=('!debug' '!strip')
_repo="https://github.com/Okazakee/avdium"
source_x86_64=("${_repo}/releases/download/v${pkgver}/avdium-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@AMD64_SHA256@')

package() {
  local dir="${srcdir}/avdium-v${pkgver}-x86_64-unknown-linux-gnu"

  install -Dm755 "${dir}/avdium" "${pkgdir}/usr/bin/avdium"
  install -Dm644 "${dir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${dir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${dir}/packaging/applications/dev.okazakee.Avdium.desktop" \
    "${pkgdir}/usr/share/applications/dev.okazakee.Avdium.desktop"
  install -Dm644 "${dir}/packaging/icons/dev.okazakee.Avdium.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dev.okazakee.Avdium.svg"
}
